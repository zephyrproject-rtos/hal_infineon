                <description>IO clear output for pin 4</description>
                <bitRange>[4:4]</bitRange>
              </field>
              <field>
                <name>OUT5</name>
                <description>IO clear output for pin 5</description>
                <bitRange>[5:5]</bitRange>
              </field>
              <field>

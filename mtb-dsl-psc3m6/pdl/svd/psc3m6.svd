                  <description>Minor revision of the product.</description>
                  <bitRange>[15:12]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>VARIANT</name>
                  <description>Major revision of the product.</description>
                  <bitRange>[19:16]</bitRange>
                  <access>read-only</access>

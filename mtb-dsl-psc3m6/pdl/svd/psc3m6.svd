          <register>
            <name>DEVICE_CTRL_EXTENDED</name>
            <description>Device Control Extended Register</description>
            <addressOffset>0xB0</addressOffset>
            <resetValue>0x00000001</resetValue>
            <resetMask>0x0000001B</resetMask>
            <fields>
              <field>
                <name>DEV_OPERATION_MODE</name>
                <description>This bit is used to select the initial device role before the block is enabled.

This field should only be written before the I3C block is enabled
This field is automatically updated by the block once the a role change takes place.

Values:
    0x0: Primary Controller (starts as the Active Controller and initializes/configures the I3C bus)
    0x1: Secondary Controller (starts as a Target, but can become the Active Controller)</description>
                <bitRange>[1:0]</bitRange>
              </field>
              <field>
                <name>GETACCCR_ACK_CTRL</name>
                <description>In Target mode of operation, this bit serves as a control to ACK/NACK the GETACCCR CCC from the Active Controller.

Values:
    0x0: ACK GETACCCR CCC
    0x1: NACK GETACCCR CCC</description>
                <bitRange>[3:3]</bitRange>
              </field>
              <field>
                <name>DEEP_SLEEP_CAP</name>
                <description>N/A</description>
                <bitRange>[4:4]</bitRange>
              </field>
            </fields>
          </register>

                      <name>ADC_CHANNEL_SEL_1_ADC13</name>
                      <description>Virtual Channel 13 selected for Loopback to Dac Buffer 1</description>
                      <value>7</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ADC_CHANNEL_SEL_1_ADC15</name>
                      <description>Virtual Channel 15 selected for Loopback to Dac Buffer 1</description>
                      <value>8</value>

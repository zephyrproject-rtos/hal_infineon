        <register>
          <name>EDTR0</name>
          <description>Power Mode Entry Delay Register 0</description>
          <addressOffset>0x160</addressOffset>
          <fields>
            <field>
              <name>OFF_DEL</name>
              <description>N/A</description>
              <bitRange>[7:0]</bitRange>
            </field>
            <field>

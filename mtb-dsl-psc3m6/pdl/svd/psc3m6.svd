          <register>
            <name>ARB_RW8_DR16</name>
            <description>Endpoint Data Register</description>
            <addressOffset>0x13E0</addressOffset>
            <resetMask>0x00000000</resetMask>
            <fields>
              <field>
                <name>DR16</name>

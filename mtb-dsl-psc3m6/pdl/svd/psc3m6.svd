                      <value>2</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ADC_CHANNEL_SEL_0_ADC4</name>
                      <description>Virtual Channel 4  selected for Loopback to Dac Buffer 0</description>
                      <value>3</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ADC_CHANNEL_SEL_0_ADC6</name>
                      <description>Virtual Channel 6  selected for Loopback to Dac Buffer 0</description>
                      <value>4</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ADC_CHANNEL_SEL_0_ADC8</name>
                      <description>Virtual Channel 8  selected for Loopback to Dac Buffer 0</description>
                      <value>5</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ADC_CHANNEL_SEL_0_ADC10</name>
                      <description>Virtual Channel 10 selected for Loopback to Dac Buffer 0</description>
                      <value>6</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ADC_CHANNEL_SEL_0_ADC12</name>
                      <description>Virtual Channel 12 selected for Loopback to Dac Buffer 0</description>
                      <value>7</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ADC_CHANNEL_SEL_0_ADC14</name>
                      <description>Virtual Channel 14 selected for Loopback to Dac Buffer 0</description>
                      <value>8</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ADC_CHANNEL_SEL_0_ADC16</name>
                      <description>Virtual Channel 16 selected for Loopback to Dac Buffer 0</description>
                      <value>9</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ADC_CHANNEL_SEL_0_ADC18</name>
                      <description>Virtual Channel 18 selected for Loopback to Dac Buffer 0</description>
                      <value>10</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ADC_CHANNEL_SEL_0_ADC20</name>
                      <description>Virtual Channel 20 selected for Loopback to Dac Buffer 0</description>
                      <value>11</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ADC_CHANNEL_SEL_0_ADC22</name>
                      <description>Virtual Channel 22 selected for Loopback to Dac Buffer 0</description>
                      <value>12</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ADC_CHANNEL_SEL_0_ADC24</name>
                      <description>Virtual Channel 24 selected for Loopback to Dac Buffer 0</description>
                      <value>13</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ADC_CHANNEL_SEL_0_ADC26</name>
                      <description>Virtual Channel 26 selected for Loopback to Dac Buffer 0</description>
                      <value>14</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ADC_CHANNEL_SEL_0_ADC28</name>
                      <description>Virtual Channel 28 selected for Loopback to Dac Buffer 0</description>
                      <value>15</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ADC_CHANNEL_SEL_0_ADC30</name>
                      <description>Virtual Channel 30 selected for Loopback to Dac Buffer 0</description>
                      <value>16</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ADC_CHANNEL_SEL_0_ADC32</name>
                      <description>Virtual Channel 32 selected for Loopback to Dac Buffer 0</description>
                      <value>17</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ADC_CHANNEL_SEL_0_ADC34</name>
                      <description>Virtual Channel 34 selected for Loopback to Dac Buffer 0</description>
                      <value>18</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>ADC_CHANNEL_SEL_1</name>
                  <description>'When ADC Loopback Source Mode is selected, this will chose which ADC Channel to connect to the DAC Buffer 1 input.
0x13-0x1F: OFF</description>
                  <bitRange>[9:5]</bitRange>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>ADC_CHANNEL_SEL_1_DISABLED</name>
                      <description>Loopback disabled for Dac Buffer 1</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ADC_CHANNEL_SEL_1_ADC1</name>
                      <description>Virtual Channel 1 selected for Loopback to Dac Buffer 1</description>
                      <value>1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ADC_CHANNEL_SEL_1_ADC3</name>
                      <description>Virtual Channel 3 selected for Loopback to Dac Buffer 1</description>
                      <value>2</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ADC_CHANNEL_SEL_1_ADC5</name>
                      <description>Virtual Channel 5 selected for Loopback to Dac Buffer 1</description>
                      <value>3</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ADC_CHANNEL_SEL_1_ADC7</name>
                      <description>Virtual Channel 7 selected for Loopback to Dac Buffer 1</description>
                      <value>4</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ADC_CHANNEL_SEL_1_ADC9</name>
                      <description>Virtual Channel 9 selected for Loopback to Dac Buffer 1</description>
                      <value>5</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ADC_CHANNEL_SEL_1_ADC11</name>
                      <description>Virtual Channel 11 selected for Loopback to Dac Buffer 1</description>
                      <value>6</value>

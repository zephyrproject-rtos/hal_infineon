          </cluster>
          <cluster>
            <dim>2</dim>
            <dimIncrement>128</dimIncrement>
            <name>FIR[%s]</name>
            <description>SAR FIR coefficient and tap registers</description>
            <addressOffset>0xC00</addressOffset>
            <register>
              <dim>16</dim>
              <dimIncrement>4</dimIncrement>
              <name>FIR_COEFS[%s]</name>
              <description>FIR Coeffecients</description>
              <addressOffset>0x0</addressOffset>
              <resetMask>0x0000FFFF</resetMask>
              <fields>
                <field>
                  <name>COEF</name>
                  <description>FIR Coefficient Value
The coefficient values can range from -1+1/215 to 1-1/215 with a resolution of 1/215. The coefficient uses twos-complement notation and the decimal point is fixed to the right of the most significant bit.
Examples: -0.25 = 0xE000 and 0.25 = 0x2000

NOTE: The max absolute value of the FIR gain must be less than 8 (sum of the coeffients), otherwise the result may overflow the allocated 16-bits.</description>
                  <bitRange>[15:0]</bitRange>
                </field>
              </fields>
            </register>
            <register>
              <dim>16</dim>
              <dimIncrement>4</dimIncrement>
              <name>FIR_TAPS[%s]</name>
              <description>FIR Taps</description>
              <addressOffset>0x40</addressOffset>
              <resetMask>0x0000FFFF</resetMask>
              <fields>
                <field>
                  <name>TAP</name>
                  <description>FIR Tap Value
In normal operation R/W by hardware
Only when MCPASS IP is enabled and SAR is enabled - these registers may be written to and read by software, typically for debug puposes.</description>
                  <bitRange>[15:0]</bitRange>
                </field>
              </fields>
            </register>
          </cluster>
        </cluster>
        <cluster>
          <name>DAC_BUFFER</name>
          <description>DAC + Buffer IP</description>
          <addressOffset>0x90000</addressOffset>
          <cluster>
            <dim>2</dim>
            <dimIncrement>1024</dimIncrement>
            <name>DAC_BUFFER[%s]</name>
            <description>Individual DAC Buffer Configuration Registers</description>
            <addressOffset>0x0</addressOffset>
            <register>
              <name>DAC_BUFFER_FIFO_DATA_IN</name>
              <description>Input data for DAC Buffer Fifo</description>
              <addressOffset>0x0</addressOffset>
              <fields>
                <field>
                  <name>INPUT_DATA</name>
                  <description>DAC Data from Direct Write Mode of Operation.
Data Access Mode of Operation:
Single Word LSB Alignment: Data[11:0]
Single Word MSB Alignment: Data[31:20]
Double Word Access LSB Alignment: Word 0: Data[11:0], Word 1[27:16]
Double Word Access MSB Alignment: Word 0: Data[15:4], Word 1[31:20]

Bits outside of these configurations shall return 0x0.

The various fields shall map to the same underlying hardware.</description>
                  <bitRange>[31:0]</bitRange>
                </field>
              </fields>
            </register>
            <register>
              <name>DAC_BUFFER_FIFO_CTRL</name>
              <description>DAC Buffer Fifo control and configuration</description>
              <addressOffset>0x4</addressOffset>
              <resetValue>0x00018000</resetValue>
              <resetMask>0x0003FF70</resetMask>
              <fields>
                <field>
                  <name>ACCESS_MODE</name>
                  <description>0: Single Word LSB Aligned
1: Single Word MSB Aligned
2: Double Word LSB Aligned
3: Double Word MSB Aligned</description>
                  <bitRange>[5:4]</bitRange>
                </field>
                <field>
                  <name>CLEAR_FIFO</name>
                  <description>Firmware sets this bit to clear all Fifo entries and reset the Read and Write Pointers. Hardware Clears this bit.</description>
                  <bitRange>[6:6]</bitRange>
                  <modifiedWriteValues>oneToSet</modifiedWriteValues>
                </field>
                <field>
                  <name>FIFO_USED</name>
                  <description>The amount of the Fifo used</description>
                  <bitRange>[11:8]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>FIFO_AVAILABLE</name>
                  <description>the amount of the file available</description>
                  <bitRange>[15:12]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>EMPTY_FLAG</name>
                  <description>Flag to indicate if the Fifo is Empty</description>
                  <bitRange>[16:16]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>FULL_FLAG</name>
                  <description>Flag to indicate if the Fifo is Full. This flag will be asserted when there is 0 room for data available during Single Word access mode. This flag will be asserted when there is room for 0 or 1 words available during Double Word access mode.</description>
                  <bitRange>[17:17]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>DAC_BUFFER_CFG</name>
              <description>DAC Buffer Control Register</description>
              <addressOffset>0x10</addressOffset>
              <resetMask>0x03F6FFFF</resetMask>
              <fields>
                <field>
                  <name>DAC_TR_START_SEL</name>
                  <description>DAC Trigger Start Select.  Select one of the MCPASS HW or FW triggers. Trigger must be PULSE mode (see INFRA). See DAC_MODE_START register to select this as the DAC start trigger.</description>
                  <bitRange>[4:0]</bitRange>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>DISABLED</name>
                      <description>N/A</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>TR0</name>
                      <description>HW (or FW) input triggers</description>
                      <value>1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>TR1</name>
                      <description>N/A</description>
                      <value>2</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>TR2</name>
                      <description>N/A</description>
                      <value>3</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>TR3</name>
                      <description>N/A</description>
                      <value>4</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>TR4</name>
                      <description>N/A</description>
                      <value>5</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>TR5</name>
                      <description>N/A</description>
                      <value>6</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>TR6</name>
                      <description>N/A</description>
                      <value>7</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>TR7</name>
                      <description>N/A</description>
                      <value>8</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>TR8</name>
                      <description>HW (or FW) input triggers</description>
                      <value>9</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>TR9</name>
                      <description>N/A</description>
                      <value>10</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>TR10</name>
                      <description>N/A</description>
                      <value>11</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>TR11</name>
                      <description>N/A</description>
                      <value>12</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>TR12</name>
                      <description>N/A</description>
                      <value>13</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>TR13</name>
                      <description>N/A</description>
                      <value>14</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>TR14</name>
                      <description>N/A</description>
                      <value>15</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>TR15</name>
                      <description>N/A</description>
                      <value>16</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>DAC_TR_UPDATE_SEL</name>
                  <description>DAC Trigger Update Select.  Select one of the triggers or internal events. See DAC_MODE for detailed operation. If one of the MCPASS HW or FW triggers are selected (see INFRA), then the trigger must be PULSE mode.  In addition, the maximum frequency of the active trigger edge must be less than or equal to CSG CLOCK/2 (every other clock).</description>
                  <bitRange>[9:5]</bitRange>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>DISABLED</name>
                      <description>N/A</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>TR0</name>
                      <description>HW (or FW) input triggers</description>
                      <value>1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>TR1</name>
                      <description>N/A</description>
                      <value>2</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>TR2</name>
                      <description>N/A</description>
                      <value>3</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>TR3</name>
                      <description>N/A</description>
                      <value>4</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>TR4</name>
                      <description>N/A</description>
                      <value>5</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>TR5</name>
                      <description>N/A</description>
                      <value>6</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>TR6</name>
                      <description>N/A</description>
                      <value>7</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>TR7</name>
                      <description>N/A</description>
                      <value>8</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>TR8</name>
                      <description>HW (or FW) input triggers</description>
                      <value>9</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>TR9</name>
                      <description>N/A</description>
                      <value>10</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>TR10</name>
                      <description>N/A</description>
                      <value>11</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>TR11</name>
                      <description>N/A</description>
                      <value>12</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>TR12</name>
                      <description>N/A</description>
                      <value>13</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>TR13</name>
                      <description>N/A</description>
                      <value>14</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>TR14</name>
                      <description>N/A</description>
                      <value>15</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>TR15</name>
                      <description>N/A</description>
                      <value>16</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>DAC_PERIOD_TC</name>
                      <description>Period terminal count. Period divider value is programmed in DAC_PERIOD register</description>
                      <value>17</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>DAC_MODE</name>
                  <description>DAC Operating Mode.  This setting may only be changed when the mode is disabled. See DAC_MODE_START.</description>
                  <bitRange>[13:10]</bitRange>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>BUFFERED</name>
                      <description>Single Value Buffered Mode </description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>HYSTERETIC</name>
                      <description>Two Value Hysteretic Buffered Mode</description>
                      <value>1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>SLOPE_RISING</name>
                      <description>Rising Slope Mode </description>
                      <value>2</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>SLOPE_FALLING</name>
                      <description>Falling Slope Mode  </description>
                      <value>3</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>SLOPE_TRIANGULAR</name>
                      <description>Triangular Slope Mode</description>
                      <value>4</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>LUT_FORWARD</name>
                      <description>LUT Forward Mode</description>
                      <value>5</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>LUT_REVERSE</name>
                      <description>LUT Reverse Mode</description>
                      <value>6</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>LUT_FWD_REV</name>
                      <description>LUT Forward Reverse Mode</description>
                      <value>7</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>FIFO</name>
                      <description>Source the Data from the Fifo</description>
                      <value>8</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ADC_LOOPBACK</name>
                      <description>Source the Data from the ADC Loopback mechanism</description>
                      <value>9</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>DAC_CONT</name>
                  <description>DAC Continuous Mode (Only valid for Slope and LUT modes)
0: Slope/LUT operation is One-Shot, last output value is held
1: Slope/LUT operation is Continuous, operation is restarted when end value is reached</description>
                  <bitRange>[14:14]</bitRange>
                </field>
                <field>
                  <name>DAC_SKIP_TR_EN</name>
                  <description>Skip the first DAC hardware update trigger afer a mode is enabled.  Allows for a minimum of a full trigger period before the first hardware update occurs. This bit should only be set before operations begin. It should remain set during operation as well.

0: First trigger following DAC_MODE_EN updates the DAC value.
1: First trigger following DAC_MODE_EN is skipped.  Following trigger updates the DAC value.</description>
                  <bitRange>[15:15]</bitRange>
                </field>
                <field>
                  <name>DAC_PARAM_SYNC_EN</name>
                  <description>Parameter Sync Enable.
0: Disabled.  Always update parameters on DAC trigger (as defined by DAC_MODE)
1: Enabled.   Only update parameters on DAC trigger if DAC_PARAM_SYNC.READY is set.</description>
                  <bitRange>[17:17]</bitRange>
                </field>
                <field>
                  <name>ENABLE</name>
                  <description>Global Enable Signal for DAC Buffer Digital instance. This bit must be set before setting any other registers as it is tied to got DAC Reset.</description>
                  <bitRange>[18:18]</bitRange>
                </field>
                <field>
                  <name>DAC_STEP</name>
                  <description>Static value of 6 bit DAC step size. Step size is DAC_STEP +1 (default is '1') , range is 1 - 64, only valid in SLOPE/LUT modes.
NOTE: In LUT mode each step jumps to a new LUT value on WORD boundaries.
So for example:
DAC_STEP = 0  (default Step size of 1) advances the LUT address by 4 (LUT WORD boundary)
DAC_STEP = 1 (Step size of 2) advances the LUT address by 8, etc</description>
                  <bitRange>[25:20]</bitRange>
                </field>
              </fields>
            </register>
            <register>
              <name>DAC_BUFFER_PARAM_SYNC</name>
              <description>DAC Parameter Synchronized Update</description>
              <addressOffset>0x14</addressOffset>
              <resetMask>0x00000001</resetMask>
              <fields>
                <field>
                  <name>READY</name>
                  <description>Use this bit to synchronize the update of multiple DAC parameters.

If DAC_PARAM_SYNC_EN bit is '1', then set this bit after writes to all parameter registers (VAL_A, VAL_B, DAC_PERIOD, DAC_STEP) are complete to synchronize parameter update on a subsequent DAC trigger This allows for writes to multiple registers to be written before new parameters are updated to avoid partial updates.

This bit is cleared by HW on the parameter update event.

if DAC_PARAM_SYNC_EN is '0', this bit is ignored and parameters are updated on the following UPDATE trigger.

NOTE: This bit can be used in conjunction with DAC_CASCADE_EN to synchronize the parameter update of multiple CSG slices.</description>
                  <bitRange>[0:0]</bitRange>
                  <modifiedWriteValues>oneToSet</modifiedWriteValues>
                </field>
              </fields>
            </register>
            <register>
              <name>DAC_BUFFER_MODE_START</name>
              <description>DAC Mode Start</description>
              <addressOffset>0x18</addressOffset>
              <resetMask>0xC0000001</resetMask>
              <fields>
                <field>
                  <name>BUSY</name>
                  <description>Read only bit to indicate that a DAC MODE has been enabled and is currently in progress.
If FW_START is used to start the mode, then the FW_START bit is equivalent to this bit and low when the mode is completed or stopped.
If HW_START is used to start the mode, then this status bit goes high on the DAC_START_TR event, and low when the mode is completed or stopped.

NOTE: This read only bit refects the state of the DAC controller which is reset in DeepSleep and therefore this bit is not a retention bit.</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>HW_START</name>
                  <description>1: Wait for subsequent DAC_START_TR  to start the selected mode.
0: Stops the selected mode.  When this bit is cleared, the current DAC_VAL will not change unless it is over-written directly - or a new DAC mode is started.
This field is automatically reset to '0' on DAC_SLOPE_DONE event (unless DAC_CONT is set for continous mode).</description>
                  <bitRange>[30:30]</bitRange>
                </field>
                <field>
                  <name>FW_START</name>
                  <description>1: Starts the selected mode on this FW write.
0: Stops the selected mode.  When this bit is cleared, the current DAC_VAL will not change unless it is over-written directly - or a new DAC mode is started.
This field is automatically reset to '0' on DAC_SLOPE_DONE event (unless DAC_CONT is set for continous mode).</description>
                  <bitRange>[31:31]</bitRange>
                </field>
              </fields>
            </register>
            <register>
              <name>DAC_BUFFER_VAL_A</name>
              <description>DAC Vaue A Buffer</description>
              <addressOffset>0x1C</addressOffset>
              <resetMask>0x00000FFF</resetMask>
              <fields>
                <field>
                  <name>VALUE</name>
                  <description>DAC A Value, usage is mode dependent (see DAC_MODE)

NOTE: In LUT modes this is the Start Address of the LUT waveform in byte address format (e.g. 0, 4, 8, ... 1F8, 1FC)</description>
                  <bitRange>[11:0]</bitRange>
                </field>
              </fields>
            </register>
            <register>
              <name>DAC_BUFFER_VAL_B</name>
              <description>DAC Value B Buffer</description>
              <addressOffset>0x20</addressOffset>
              <resetMask>0x00000FFF</resetMask>
              <fields>
                <field>
                  <name>VALUE</name>
                  <description>DAC B Value, usage is mode dependent (see DAC_MODE)

NOTE: In LUT modes this is the End Address of the LUT waveform in byte address format (e.g. 0, 4, 8, ... 1F8, 1FC)</description>
                  <bitRange>[11:0]</bitRange>
                </field>
              </fields>
            </register>
            <register>
              <name>DAC_BUFFER_PERIOD</name>
              <description>DAC Period Buffer</description>
              <addressOffset>0x24</addressOffset>
              <resetMask>0x000FFFF8</resetMask>
              <fields>
                <field>
                  <name>PERIOD_FRAC</name>
                  <description>5-bit Fractional Divide Value. Allows for fractional count in the range [0, 31/32]</description>
                  <bitRange>[7:3]</bitRange>
                </field>
                <field>
                  <name>PERIOD_INT</name>
                  <description>12-bit Integer Divide Value.
Integer count  by (1+PERIOD_INT). Allows for integer counts in the range [1, 4096].</description>
                  <bitRange>[19:8]</bitRange>
                </field>
              </fields>
            </register>
            <register>
              <name>DAC_BUFFER_VAL</name>
              <description>Firmware Write port (excluding Fifo)</description>
              <addressOffset>0x28</addressOffset>
              <resetMask>0x00000FFF</resetMask>
              <fields>
                <field>
                  <name>VALUE</name>
                  <description>Direct drive to DAC Hard IP for output.
When DAC_MODE_EN is '0', the value in this register is output.  A write to this register also STOPs the current DAC_MODE operation, and subsequent DAC triggers are ignored.</description>
                  <bitRange>[11:0]</bitRange>
                </field>
              </fields>
            </register>
            <register>
              <name>DAC_BUFFER_STATUS</name>
              <description>Read of Current DAC Value</description>
              <addressOffset>0x2C</addressOffset>
              <access>read-only</access>
              <resetMask>0x00000FFF</resetMask>
              <fields>
                <field>
                  <name>DAC_VAL</name>
                  <description>Read Only value of current digital DAC output</description>
                  <bitRange>[11:0]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>DAC_BUFFER_ANA_CTRL_1</name>
              <description>Control Bits</description>
              <addressOffset>0x40</addressOffset>
              <resetMask>0x8000001F</resetMask>
              <fields>
                <field>
                  <name>DAC_CTRL_PWR_EN</name>
                  <description>0x0: Block is disabled.
0x1: Block is enabled when act_isolate_hv_n = 1 and clk_8m is provided.</description>
                  <bitRange>[0:0]</bitRange>
                </field>
                <field>
                  <name>DAC_COMP_EN</name>
                  <description>Comparator Enable</description>
                  <bitRange>[1:1]</bitRange>
                </field>
                <field>
                  <name>DAC_COMP_HYST_DIR</name>
                  <description>Comparator Hysterysis Direciton</description>
                  <bitRange>[2:2]</bitRange>
                </field>
                <field>
                  <name>DAC_COMP_HYST_EN</name>
                  <description>Comparator Hysterysis Enable</description>
                  <bitRange>[3:3]</bitRange>
                </field>
                <field>
                  <name>DAC_ENABLE_GB</name>
                  <description>Buffer Gain Boost Enable</description>
                  <bitRange>[4:4]</bitRange>
                </field>
                <field>
                  <name>DAC_READY</name>
                  <description>DAC Ready Status Monitor</description>
                  <bitRange>[31:31]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>DAC_BUFFER_ANA_CTRL_2</name>
              <description>Control Bits</description>
              <addressOffset>0x44</addressOffset>
              <resetMask>0x003F0FFF</resetMask>
              <fields>
                <field>
                  <name>DAC_CTRL_REF_SEL</name>
                  <description>0x0: VCCD is DAC reference.
0x1: DAC_VREF_HV is DAC reference.</description>
                  <bitRange>[0:0]</bitRange>
                </field>
                <field>
                  <name>DAC_CTRL_BUF_OUT_SEL</name>
                  <description>0x0: Sends Buffered DAC Output to pin, DAC_BUF_OUT_HV, Pad AN[5]
0x1: TBD</description>
                  <bitRange>[1:1]</bitRange>
                </field>
                <field>
                  <name>DAC_CTRL_PWR_MODE</name>
                  <description>Buffer Drive State</description>
                  <bitRange>[3:2]</bitRange>
                </field>
                <field>
                  <name>DAC_TRIM_OFFSET</name>
                  <description>dac offset trim  (buffer offset trim)</description>
                  <bitRange>[9:4]</bitRange>
                </field>
                <field>
                  <name>DAC_COMPENSATION_TRIM</name>
                  <description>Compensation Capacitor Setting</description>
                  <bitRange>[11:10]</bitRange>
                </field>
                <field>
                  <name>DAC_SLOPE_TRIM_OFFSET</name>
                  <description>Offset Slope Correction Bits for Buffers</description>
                  <bitRange>[21:16]</bitRange>
                </field>
              </fields>
            </register>
            <register>
              <name>DAC_BUFFER_ANA_MITIGATION_CTRL</name>
              <description>Risk Mitigation Control Bits. May be removed in the future.</description>
              <addressOffset>0x48</addressOffset>
              <resetMask>0x0000001F</resetMask>
              <fields>
                <field>
                  <name>DAC_RMP_IDAC</name>
                  <description>N/A</description>
                  <bitRange>[1:0]</bitRange>
                </field>
                <field>
                  <name>DAC_RMP_OP_1X</name>
                  <description>Used in 1x mode of the DAC</description>
                  <bitRange>[2:2]</bitRange>
                </field>
                <field>
                  <name>DAC_RMP_OP_10X</name>
                  <description>Used in 10x mode of the DAC</description>
                  <bitRange>[3:3]</bitRange>
                </field>
                <field>
                  <name>DAC_RMP_PMP</name>
                  <description>Related to use of Pump inside the DAC</description>
                  <bitRange>[4:4]</bitRange>
                </field>
              </fields>
            </register>
            <register>
              <name>DAC_BUFFER_ANA_DFT_CTRL</name>
              <description>ADFT Control bits</description>
              <addressOffset>0x4C</addressOffset>
              <resetMask>0x00000007</resetMask>
              <fields>
                <field>
                  <name>DAC_CTRL_ADFT_SEL</name>
                  <description>ADFT Configuration Bits</description>
                  <bitRange>[2:0]</bitRange>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>DISABLED</name>
                      <description>Hi-Z</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ADFT_SEL_DAC_BUF_OUT_HV</name>
                      <description>N/A</description>
                      <value>1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ADFT_SEL_DAC_BUF_OUT_INT_HV</name>
                      <description>N/A</description>
                      <value>2</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ADFT_SEL_VPUMP</name>
                      <description>Pump feed back voltage</description>
                      <value>3</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ADFT_SEL_IDC_BUF</name>
                      <description>N/A</description>
                      <value>4</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ADFT_SEL_DAC_OUT</name>
                      <description>N/A</description>
                      <value>5</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ADFT_SEL_COMP_HV</name>
                      <description>Offset trim comp output</description>
                      <value>6</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>DISABLED_7</name>
                      <description>Hi-Z</description>
                      <value>7</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
            <register>
              <name>DAC_BUFFER_INTR</name>
              <description>DAC + Buffer Interrupt register</description>
              <addressOffset>0x100</addressOffset>
              <resetMask>0x0000007F</resetMask>
              <fields>
                <field>
                  <name>DAC_BUFFER_FIFO_OVERFLOW</name>
                  <description>Set once when FIFO reaches full. If no data is pulled from the Fifo, this interrupt shall not continue firing. This interrupt will be asserted when there is 0 room for data available during Single Word access mode. This interrupt will be asserted when there is room for 0 or 1 words available during Double Word access mode.</description>
                  <bitRange>[0:0]</bitRange>
                  <modifiedWriteValues>oneToClear</modifiedWriteValues>
                </field>
                <field>
                  <name>DAC_BUFFER_FIFO_UNDERFLOW</name>
                  <description>Set when FIFO has 0 elements i.e. is empty.</description>
                  <bitRange>[1:1]</bitRange>
                  <modifiedWriteValues>oneToClear</modifiedWriteValues>
                </field>
                <field>
                  <name>DAC_BUFFER_FIFO_PAST_UNDERFLOW</name>
                  <description>Set when FIFO is empty, but Trigger tries to Pull Data from the empty Fifo.</description>
                  <bitRange>[2:2]</bitRange>
                  <modifiedWriteValues>oneToClear</modifiedWriteValues>
                </field>
                <field>
                  <name>DAC_BUFFER_FIFO_LOW_THRESHOLD</name>
                  <description>Set when FIFO is almost empty i.e. FIFO space left with just 3 entries</description>
                  <bitRange>[3:3]</bitRange>
                  <modifiedWriteValues>oneToClear</modifiedWriteValues>
                </field>
                <field>
                  <name>DAC_HW_START</name>
                  <description>This DAC_MODE operation was started with a HW START trigger.</description>
                  <bitRange>[4:4]</bitRange>
                  <modifiedWriteValues>oneToClear</modifiedWriteValues>
                </field>
                <field>
                  <name>DAC_SLOPE_DONE</name>
                  <description>When SLOPE or LUT mode is enabled, this interrupt is set when the SLOPE (or LUT waveform) has completed.
This interrupt is also set periodically on the last value of a DAC SLOPE in continuous mode</description>
                  <bitRange>[5:5]</bitRange>
                  <modifiedWriteValues>oneToClear</modifiedWriteValues>
                </field>
                <field>
                  <name>DAC_BUF_EMPTY</name>
                  <description>When BUFFERED or HYSTERETIC mode is enabled, this interrupt is set when there is a DAC UPDATE trigger that transfers the buffered value(s) to active value(s) (see mode operation) and it means that the user may write new values to the buffer registers.</description>
                  <bitRange>[6:6]</bitRange>
                  <modifiedWriteValues>oneToClear</modifiedWriteValues>
                </field>
              </fields>
            </register>
            <register>
              <name>DAC_BUFFER_INTR_SET</name>
              <description>DAC + Buffer Interrupt request set register</description>
              <addressOffset>0x104</addressOffset>
              <resetMask>0x0000007F</resetMask>
              <fields>
                <field>
                  <name>DAC_BUFFER_FIFO_OVERFLOW</name>
                  <description>Write with '1' to set corresponding bit in interrupt request register.</description>
                  <bitRange>[0:0]</bitRange>
                  <modifiedWriteValues>oneToSet</modifiedWriteValues>
                </field>
                <field>
                  <name>DAC_BUFFER_FIFO_UNDERFLOW</name>
                  <description>Write with '1' to set corresponding bit in interrupt request register.</description>
                  <bitRange>[1:1]</bitRange>
                  <modifiedWriteValues>oneToSet</modifiedWriteValues>
                </field>
                <field>
                  <name>DAC_BUFFER_FIFO_PAST_UNDERFLOW</name>
                  <description>Write with '1' to set corresponding bit in interrupt request register.</description>
                  <bitRange>[2:2]</bitRange>
                  <modifiedWriteValues>oneToSet</modifiedWriteValues>
                </field>
                <field>
                  <name>DAC_BUFFER_FIFO_LOW_THRESHOLD</name>
                  <description>Write with '1' to set corresponding bit in interrupt request register.</description>
                  <bitRange>[3:3]</bitRange>
                  <modifiedWriteValues>oneToSet</modifiedWriteValues>
                </field>
                <field>
                  <name>DAC_HW_START</name>
                  <description>Write with '1' to set corresponding bit in interrupt request register.</description>
                  <bitRange>[4:4]</bitRange>
                  <modifiedWriteValues>oneToSet</modifiedWriteValues>
                </field>
                <field>
                  <name>DAC_SLOPE_DONE</name>
                  <description>Write with '1' to set corresponding bit in interrupt request register.</description>
                  <bitRange>[5:5]</bitRange>
                  <modifiedWriteValues>oneToSet</modifiedWriteValues>
                </field>
                <field>
                  <name>DAC_BUF_EMPTY</name>
                  <description>Write with '1' to set corresponding bit in interrupt request register.</description>
                  <bitRange>[6:6]</bitRange>
                  <modifiedWriteValues>oneToSet</modifiedWriteValues>
                </field>
              </fields>
            </register>
            <register>
              <name>DAC_BUFFER_INTR_MASK</name>
              <description>DAC + Buffer Interrupt request mask</description>
              <addressOffset>0x108</addressOffset>
              <resetMask>0x0000007F</resetMask>
              <fields>
                <field>
                  <name>DAC_BUFFER_FIFO_OVERFLOW</name>
                  <description>Mask bit for corresponding bit in interrupt request register.</description>
                  <bitRange>[0:0]</bitRange>
                </field>
                <field>
                  <name>DAC_BUFFER_FIFO_UNDERFLOW</name>
                  <description>Mask bit for corresponding bit in interrupt request register.</description>
                  <bitRange>[1:1]</bitRange>
                </field>
                <field>
                  <name>DAC_BUFFER_FIFO_PAST_UNDERFLOW</name>
                  <description>Mask bit for corresponding bit in interrupt request register.</description>
                  <bitRange>[2:2]</bitRange>
                </field>
                <field>
                  <name>DAC_BUFFER_FIFO_LOW_THRESHOLD</name>
                  <description>Mask bit for corresponding bit in interrupt request register.</description>
                  <bitRange>[3:3]</bitRange>
                </field>
                <field>
                  <name>DAC_HW_START</name>
                  <description>Mask bit for corresponding bit in interrupt request register.</description>
                  <bitRange>[4:4]</bitRange>
                </field>
                <field>
                  <name>DAC_SLOPE_DONE</name>
                  <description>Mask bit for corresponding bit in interrupt request register.</description>
                  <bitRange>[5:5]</bitRange>
                </field>
                <field>
                  <name>DAC_BUF_EMPTY</name>
                  <description>Mask bit for corresponding bit in interrupt request register.</description>
                  <bitRange>[6:6]</bitRange>
                </field>
              </fields>
            </register>
            <register>
              <name>DAC_BUFFER_INTR_MASKED</name>
              <description>DAC + Buffer Interrupt request masked</description>
              <addressOffset>0x10C</addressOffset>
              <access>read-only</access>
              <resetMask>0x0000007F</resetMask>
              <fields>
                <field>
                  <name>DAC_BUFFER_FIFO_OVERFLOW</name>
                  <description>Logical and of corresponding request and mask bits.</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>DAC_BUFFER_FIFO_UNDERFLOW</name>
                  <description>Logical and of corresponding request and mask bits.</description>

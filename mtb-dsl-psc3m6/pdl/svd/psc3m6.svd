                      <value>1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>GATE_ON_ZERO</name>
                      <description>Comparator output is gated to 0 by a '0' level trigger. Edge based blanking is disabled.</description>
                      <value>2</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>CMP_BLANK_TR_SEL</name>

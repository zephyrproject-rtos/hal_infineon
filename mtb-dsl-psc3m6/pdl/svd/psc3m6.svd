                <name>FM_RED_CTL45_ADDR</name>
                <description>Internal Register - Spare for future use - Read Undefined, Write Ignore</description>
                <bitRange>[31:0]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>FM_CAL_CTL8_ADDR</name>
            <description>0</description>
